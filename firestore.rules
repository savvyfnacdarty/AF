rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ressources sensibles de l'outil (logo, cachet, masque du titre d'habilitation)
    match /secure/{docId} {
      // Comptes autorisés à ouvrir l'outil (adresses en MINUSCULES)
      allow read: if request.auth != null
        && request.auth.token.email in [
          'prenom.nom@exemple.fr',
          'formateur2@exemple.fr'
        ];
      // Seul(s) l'administrateur(s) peut publier
      allow write: if request.auth != null
        && request.auth.token.email in ['prenom.nom@exemple.fr'];
    }

    // Tout le reste est fermé
    match /{document=**} { allow read, write: if false; }
  }
}
